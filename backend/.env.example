# --- AI narrative (optional) ------------------------------------------------
# Leave the key empty to disable the AI personalization feature; the app still
# works fully with the deterministic reading engine.
#
# Option A - plain OpenAI-compatible endpoint:
#   AI_API_KEY=sk-...
#   AI_BASE_URL=https://api.openai.com/v1
# Option B - Portkey gateway (PORTKEY_* are accepted as aliases of AI_*):
#   PORTKEY_API_KEY=...
#   PORTKEY_BASE_URL=https://airouter-sbx.bdp.wdc.com/v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
